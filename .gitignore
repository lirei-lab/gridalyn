# Gridalyn generated digital twin artifacts
digital_twin/**/*.parquet
digital_twin/**/*.pkl
digital_twin/**/*.npy
digital_twin/**/*.npz
digital_twin/timeseries/
digital_twin/flexibility/*.parquet
digital_twin/semantic/*.parquet
digital_twin/models/**/*.parquet

# Instance-local generated digital twin artifacts. The root `digital_twin`
# symlink is kept for compatibility, but the physical workspace lives here.
instances/*/digital_twin/**/*.parquet
instances/*/digital_twin/**/*.pkl
instances/*/digital_twin/**/*.npy
instances/*/digital_twin/**/*.npz
instances/*/digital_twin/timeseries/
instances/*/digital_twin/flexibility/*.parquet
instances/*/digital_twin/semantic/*.parquet
instances/*/digital_twin/models/**/*.parquet

# Gridalyn project and legacy outputs
projects/*/outputs/

# Dashboard generated data bundles
dashboard/public/

# Project-local manuscript/presentation figure scripts are publication support,
# not reusable platform workflow stages.
projects/*/scripts/manuscript_figures/

# Private manuscript and presentation workspace.
#
# Manuscripts are not part of the public Gridalyn platform repository. Keep
# papers, presentations, reviews, and generated publication figures local or in
# a separate publication repository.
manuscripts/

# Manuscript and presentation generated artifacts
manuscripts/**/figures/generated/
manuscripts/**/*.aux
manuscripts/**/*.bbl
manuscripts/**/*.bcf
manuscripts/**/*.blg
manuscripts/**/*.fdb_latexmk
manuscripts/**/*.fls
manuscripts/**/*.lof
manuscripts/**/*.log
manuscripts/**/*.lot
manuscripts/**/*.out
manuscripts/**/*.run.xml
manuscripts/**/*.synctex.gz
manuscripts/**/*.toc

clusters

# Compiled manuscript PDFs are release artifacts, not source files
manuscripts/**/*.pdf

