{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gridalyn StudyProject",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "gridalyn.io/v1alpha1" },
    "kind": { "const": "StudyProject" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "inputs", "artifacts", "workflow", "validation"],
      "properties": {
        "pathBase": {
          "type": "string",
          "enum": ["project", "repo"],
          "default": "project"
        },
        "simulation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Runner-reachable simulation settings, recorded verbatim in the run manifest's provenance block.",
          "properties": {
            "seed": {
              "type": "integer",
              "description": "The single RNG base this study's stages draw from. Use it only when there genuinely is one; a study with several independent streams declares 'seeds' instead, because a scalar that names one of several streams is provenance a reader cannot reproduce from. Recorded as provenance.seeds.base."
            },
            "seed_base": {
              "type": "integer",
              "description": "Alias of 'seed', read when 'seed' is absent."
            },
            "seeds": {
              "type": "object",
              "description": "Named independent RNG streams, for studies that have more than one. Each name must be wired to the code that consumes it -- a declared value the stage script does not actually read is worse than no declaration, because it looks reproducible. Recorded as provenance.seeds.streams.",
              "minProperties": 1,
              "additionalProperties": { "type": "integer" }
            },
            "powerflowBackend": {
              "type": "string",
              "minLength": 1,
              "description": "The backend ID this study's solving stages resolve through by default, via ProjectScript.powerflow_backend(). Recorded as provenance.powerflow_backend.backend_id, with provenance.powerflow_backend.declared_source stating whether it was declared here or inherited from the registry default."
            },
            "clearingEngine": {
              "type": "string",
              "enum": ["selection"],
              "description": "The clearing surface this study's stages actually use, when it clears at all. Validated against the modules gridalyn.operations.clearing actually ships, so a retired mode stops being accepted on its own. Omit it for a study that does no flexibility clearing: provenance then records null rather than naming an engine no stage ran. Recorded as provenance.clearing_engine.name."
            },
            "surrogate": {
              "type": "string",
              "minLength": 1,
              "description": "The surrogate ID this study's stages resolve through when they substitute a surrogate for a full power-flow solve, via ProjectScript.surrogate(). A surrogate answers in place of physics, so which one answered is a property of the run: recorded as provenance.surrogate.surrogate_id together with its stated error bound, and provenance.surrogate.declared_source states whether it was declared here or inherited from the registry default."
            },
            "powerflowBackendByStage": {
              "type": "object",
              "description": "Per-stage overrides of powerflowBackend, for a study whose stages genuinely solve with different engines. A single scalar cannot describe such a study, and recording one names an engine some stage did not use. Keys are workflow stage IDs; each must exist in the workflow. Recorded as provenance.powerflow_backend.by_stage.",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        "problem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "dataset", "environment", "objective", "model", "scenarios"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "dataset": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 },
            "objective": { "type": "string", "minLength": 1 },
            "model": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type", "name"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "asset_model",
                    "forecast_model",
                    "simulation_model",
                    "optimization_model",
                    "control_model",
                    "market_model",
                    "operations_model",
                    "workflow_model"
                  ]
                },
                "name": { "type": "string", "minLength": 1 }
              }
            },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "role"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "role": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "parameters": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        },
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "objective": { "type": "string" },
              "scenario": { "type": "string", "minLength": 1 },
              "scenarios": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "metrics": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "model": { "type": "string", "minLength": 1 },
              "artifacts": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "parameters": { "type": "object", "additionalProperties": true }
            },
            "anyOf": [
              { "required": ["scenario"] },
              { "required": ["scenarios"] }
            ]
          }
        },
        "inputs": { "type": "object" },
        "artifacts": { "type": "object" },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requiredReports": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "requiredFigures": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "senseChecker": {
              "type": "string",
              "minLength": 3,
              "pattern": "^[^:]+\\.py:[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Project-relative '<module>.py:<function>' reference to this study's own objective sense checks. The library discovers the checker here instead of holding a table of study names, so adding a study needs no library edit. Authors write against gridalyn.projects.sense_check_api."
            },
            "objectiveArtifacts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Project-relative paths this study's objective must produce. Checked for existence before the sense checker runs, so a checker reports a located 'missing_objective_artifact' rather than dying on FileNotFoundError."
            },
            "senseChecks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "report", "field"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "report": { "type": "string", "minLength": 1 },
                  "field": { "type": "string", "minLength": 1 },
                  "severity": { "type": "string", "enum": ["error", "warning"] },
                  "message": { "type": "string" },
                  "equals": {},
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "gt": { "type": "number" },
                  "gte": { "type": "number" },
                  "lt": { "type": "number" },
                  "lte": { "type": "number" }
                },
                "anyOf": [
                  { "required": ["equals"] },
                  { "required": ["min"] },
                  { "required": ["max"] },
                  { "required": ["gt"] },
                  { "required": ["gte"] },
                  { "required": ["lt"] },
                  { "required": ["lte"] }
                ]
              }
            }
          }
        }
      }
    }
  }
}
