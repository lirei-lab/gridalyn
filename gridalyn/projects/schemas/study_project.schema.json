{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gridalyn StudyProject",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "gridalyn.io/v1alpha1" },
    "kind": { "const": "StudyProject" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "inputs", "artifacts", "workflow", "validation"],
      "properties": {
        "pathBase": {
          "type": "string",
          "enum": ["project", "repo"],
          "default": "project"
        },
        "simulation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Runner-reachable simulation settings. 'seed' (or its 'seed_base' alias) is the base from which gridalyn.projects.runner._resolve_seeds derives the per-stage {stage_id: seed + index} map recorded in provenance.seeds. Omitting it makes the runner fall back to the single-'base' form, which records null.",
          "properties": {
            "seed": { "type": "integer" },
            "seed_base": { "type": "integer" }
          }
        },
        "problem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "dataset", "environment", "objective", "model", "scenarios"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "dataset": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 },
            "objective": { "type": "string", "minLength": 1 },
            "model": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type", "name"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "asset_model",
                    "forecast_model",
                    "simulation_model",
                    "optimization_model",
                    "control_model",
                    "market_model",
                    "operations_model",
                    "workflow_model"
                  ]
                },
                "name": { "type": "string", "minLength": 1 }
              }
            },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "role"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "role": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "parameters": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        },
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "objective": { "type": "string" },
              "scenario": { "type": "string", "minLength": 1 },
              "scenarios": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "metrics": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "model": { "type": "string", "minLength": 1 },
              "artifacts": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "parameters": { "type": "object", "additionalProperties": true }
            },
            "anyOf": [
              { "required": ["scenario"] },
              { "required": ["scenarios"] }
            ]
          }
        },
        "inputs": { "type": "object" },
        "artifacts": { "type": "object" },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requiredReports": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "requiredFigures": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "senseChecks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "report", "field"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "report": { "type": "string", "minLength": 1 },
                  "field": { "type": "string", "minLength": 1 },
                  "severity": { "type": "string", "enum": ["error", "warning"] },
                  "message": { "type": "string" },
                  "equals": {},
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "gt": { "type": "number" },
                  "gte": { "type": "number" },
                  "lt": { "type": "number" },
                  "lte": { "type": "number" }
                },
                "anyOf": [
                  { "required": ["equals"] },
                  { "required": ["min"] },
                  { "required": ["max"] },
                  { "required": ["gt"] },
                  { "required": ["gte"] },
                  { "required": ["lt"] },
                  { "required": ["lte"] }
                ]
              }
            }
          }
        }
      }
    }
  }
}
