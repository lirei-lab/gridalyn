{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gridalyn StudyProject",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "gridalyn.io/v1alpha1" },
    "kind": { "const": "StudyProject" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "artifacts", "workflow", "validation"],
      "properties": {
        "pathBase": {
          "type": "string",
          "enum": ["project", "repo"],
          "default": "project"
        },
        "inputs": { "type": "object" },
        "artifacts": { "type": "object" },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requiredReports": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "requiredFigures": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
