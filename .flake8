[flake8]
# Set maximum line length
max-line-length = 88

# Ignore specific errors and warnings
ignore = 
    E203, 
    E266,  
    W503,  
    E501,  
    E731,  

# Exclude directories and files
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    docs,
    tests,
    venv,
    .venv,
    .mypy_cache,
    .pytest_cache

# Per-file waivers. templates.py: B907 fires on quotes inside triple-quoted
# *template text* (the generated project.yaml / report script), where "{name}"
# must stay literal double quotes in the emitted file -- `!r` would change the
# generated bytes, and an inline `# noqa` would be emitted into the template
# output. Pre-existing on main at the same four lines.
#
# clearing/engine_mode.py: C901,E226. All four sites are pre-existing on main --
# `MarketSimulationEngine.run` (39), `DSODispatcher.detect_congestion_window`
# (18), `DSODispatcher.auction_clear_capacity` (13) and one E226. Without this
# waiver the file cannot be committed at all, so every touch reaches for
# `--no-verify` and the hook stops protecting the other 192 modules. This is a
# WAIVER WITH AN EXPIRY, not a verdict that the complexity is acceptable:
# decomposing `run` is scheduled work, and the entry shrinks as each function
# comes back under 10. It has already moved once -- `run` was 40 before the
# byte-identical `is_profiled` arms were collapsed. Do not add functions here;
# the list is meant to get shorter.
per-file-ignores =
    gridalyn/projects/templates.py: B907
    gridalyn/operations/clearing/engine_mode.py: C901,E226

# Set complexity threshold
max-complexity = 10

# Require docstrings
docstring-convention = google

# Enable flake8-bugbear
select = 
    B,
    C,
    E,
    F,
    W,
    B9

# Enable flake8-docstrings
docstring-style = google

# Enable flake8-import-order
import-order-style = google

# Enable flake8-builtins
builtins-ignorelist = 
    id,
    input,
    type,
    file,
    filter,
    map,
    next,
    object,
    open,
    range,
    str,
    super,
    zip
