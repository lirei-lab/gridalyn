[flake8]
# Set maximum line length
max-line-length = 88

# Ignore specific errors and warnings
ignore = 
    E203, 
    E266,  
    W503,  
    E501,  
    E731,  

# Exclude directories and files
exclude = 
    .git,
    __pycache__,
    build,
    dist,
    docs,
    tests,
    venv,
    .venv,
    .mypy_cache,
    .pytest_cache

# Per-file waivers. templates.py: B907 fires on quotes inside triple-quoted
# *template text* (the generated project.yaml / report script), where "{name}"
# must stay literal double quotes in the emitted file -- `!r` would change the
# generated bytes, and an inline `# noqa` would be emitted into the template
# output. Pre-existing on main at the same four lines.
#
# graph.py / validation.py: C901 (max-complexity) is pre-existing debt in
# PowerGridGraph._create_cluster_mst and validate_semantic_graph, confirmed
# via `git stash` to predate the 2026-08-19 twin/semantic audit fixes that
# first touched these files under this config -- neither function's
# complexity moved. Waived rather than refactored in an otherwise-unrelated
# bugfix diff; a real reduction is separate work.
#
# buildings.py (datagen): C901 in Building.step, pre-existing (Phase 32,
# 2026-08-20, touched this file's module docstring only -- confirmed by diff
# that step()'s body is unchanged). The complexity is inherent to the
# physics being modeled (per-zone thermostat hysteresis + background load in
# one discrete-time step) and this function backs pinned regression
# baselines (e.g. admm_thermal_consensus); a real reduction needs its own
# verified-no-output-change pass, not a coherence-audit side effect.
per-file-ignores =
    gridalyn/projects/templates.py: B907
    gridalyn/twin/core/graph.py: C901
    gridalyn/twin/semantic/validation.py: C901
    gridalyn/assets/datagen/agents/buildings.py: C901

# Set complexity threshold
max-complexity = 10

# Require docstrings
docstring-convention = google

# Enable flake8-bugbear
select = 
    B,
    C,
    E,
    F,
    W,
    B9

# Enable flake8-docstrings
docstring-style = google

# Enable flake8-import-order
import-order-style = google

# Enable flake8-builtins
builtins-ignorelist = 
    id,
    input,
    type,
    file,
    filter,
    map,
    next,
    object,
    open,
    range,
    str,
    super,
    zip
